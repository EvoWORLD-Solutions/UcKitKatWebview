<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Require by org.chromium ! -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="UC WebView Manager"
		android:icon="@mipmap/ic_launcher_browser"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="UC WebView Manager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".GeneralSettingsActivity"
            android:exported="false"
            android:label="General" />

        <activity
            android:name=".PrivacySettingsActivity"
            android:exported="false"
            android:label="Privacy" />

        <activity
            android:name=".SiteRulesActivity"
            android:exported="false"
            android:label="Site rules" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="About" />

        <!-- File chooser upload -->
        <provider
            android:name=".SimpleFileProvider"
            android:authorities="com.evoworld.uckitkatwebview.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="UcKitKatWebview" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />

    </application>

</manifest>