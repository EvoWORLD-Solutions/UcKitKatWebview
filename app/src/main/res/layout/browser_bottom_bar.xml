<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_bar_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical">

    <View
        android:layout_width="fill_parent"
        android:layout_height="1px"
        android:background="@color/bottom_bar_divider" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:background="@color/bottom_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/HoloButton"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:src="@drawable/ic_back_holo_dark" />

        <ImageView
            android:id="@+id/btn_forward"
            style="@style/HoloButton"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:src="@drawable/ic_forward_holo_dark" />

        <ImageView
            android:id="@+id/btn_bookmarks"
            style="@style/HoloButton"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:src="@drawable/ic_bookmark_off_holo_dark" />

        <ImageView
            android:id="@+id/btn_hide_bar"
            style="@style/HoloButton"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:src="@drawable/ic_close_window_holo_dark" />
    </LinearLayout>
</LinearLayout>